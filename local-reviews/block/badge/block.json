{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "local-reviews/badge",
	"version": "1.5.1",
	"title": "Bewertungs-Badge (Local Reviews)",
	"category": "widgets",
	"icon": "awards",
	"description": "Sterne und Anzahl der Bewertungen, klassisch in einer Zeile oder gestapelt mit Plattformen und Linktext.",
	"keywords": [ "badge", "bewertungen", "google", "sterne" ],
	"textdomain": "local-reviews",
	"attributes": {
		"anchor": { "type": "string", "default": "" },
		"brand": { "type": "boolean", "default": true },
		"logo": { "type": "string", "default": "", "enum": [ "", "google", "none", "image" ] },
		"rating": { "type": "boolean", "default": false },
		"label": { "type": "string", "default": "Bewertungen" },
		"arrow": { "type": "boolean", "default": true },
		"link": { "type": "string", "default": "none", "enum": [ "none", "google", "custom" ] },
		"url": { "type": "string", "default": "" },
		"count": { "type": "string", "default": "", "enum": [ "", "google", "local" ] },
		"variant": { "type": "string", "default": "", "enum": [ "", "classic", "stacked" ] },
		"link_text": { "type": "string", "default": "Alle Bewertungen ansehen" },
		"subline": { "type": "string", "default": "" },
		"wrapper_class": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "local-reviews-frontend",
	"render": "file:./render.php"
}
